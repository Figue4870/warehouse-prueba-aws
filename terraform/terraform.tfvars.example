# Copia este archivo como terraform.tfvars (terraform.tfvars NO se sube al repositorio)

# OBLIGATORIO: el repositorio con este proyecto (público, o con un token de solo lectura)
repo_url    = "https://github.com/TU-USUARIO/TU-REPO.git"
repo_branch = "main"

# Recomendado: solo tu IP para SSH y consolas (búscala en https://checkip.amazonaws.com)
# admin_cidr   = "181.50.10.20/32"
# allowed_cidr = "0.0.0.0/0"

# instance_type = "t3.small"

# Fase 7: plataforma central
# central_instance_type   = "t3.small"
central_rabbit_password = "cambia-esta-clave"   # mínimo 8: letras, números, _ o -

# Reportes con Athena (S3 + Glue + Athena). false = solo las máquinas
# enable_analytics = true
